PORT=5000
NODE_ENV=development

CLIENT_URL=http://localhost:3000

# DB Connection: local | neon | supabase
DB_TYPE='local'

# === LOCAL PG ===
DB_USER=postgres
DB_HOST=localhost
DB_NAME=eco-light
DB_PASSWORD=root
DB_PORT=5432
DB_SSL=false

# === SUPABASE ===
SUPABASE_DATABASE_URL=postgres://<user>:<pass>@<host>:<port>/<db>?sslmode=require

# JWT Config
JWT_ACCESS_SECRET=your_secure_secret_123
JWT_REFRESH_SECRET=your_refresh_secret_456

# Seed Admin
SEED_ADMIN_EMAIL=admin@ecolight.com
SEED_ADMIN_PASSWORD=Admin@12345

# SMTP Config
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
FROM_EMAIL=no-reply@gmail.com

# Redis Config
REDIS_URL=redis://localhost:6379

# === MQTT BROKER ===
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_BROKER_URL=mqtt://localhost:1883

# === MQTT TOPICS ===
MQTT_TOPIC_TRIGGER=camera/trigger
MQTT_TOPIC_REQUEST=ai/inference/request
MQTT_TOPIC_RESULT=ai/inference/result
MQTT_TOPIC_CONTROL=kelas/control

# === AUTOMATION CONFIG ===
OCCUPANCY_TIMEOUT_MINS=5
DEBOUNCE_TIME_MS=3000

# === AI SERVICE ===
AI_SERVICE_URL=http://localhost:8000

# Boot Recovery
BOOT_RECOVERY_DELAY=15
# Seconds to wait after MQTT connects before sending restore commands
# Set to 15-20s to give ESP32 time to boot and subscribe

# DB Health Check  
DB_MAX_RETRIES=20
DB_RETRY_INTERVAL=3
MQTT_MAX_RETRIES=20
MQTT_RETRY_INTERVAL=3
