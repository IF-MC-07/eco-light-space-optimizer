APP_NAME="AI Service"
CLIENT_URL=http://localhost:3000
DEBUG=True
ENVIRONMENT=development
PORT=8000

# Database
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=root
DB_NAME=eco-light
DB_PORT=5432
DB_TYPE=local

# MQTT
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=

# MQTT Topics
MQTT_TOPIC_TRIGGER=camera/trigger
MQTT_TOPIC_REQUEST=ai/inference/request

# MQTT Topics (auto-namespaced by camera ID, no need to change)
MQTT_TOPIC_RESULT=ai/inference/result
# Final topic will be: ai/inference/result/CAM-001

MQTT_TOPIC_CONTROL=kelas/control

# Model
MODEL_PATH=yolov8n.pt

# Service Config
CAMERA_SOURCE=0

# Camera & Room Identity
# Each room runs its own instance of this service with a unique ID_KAMERA
# Match this value exactly with camera_id in the cameras table (VARCHAR)
ID_KAMERA=CAM-001

# To run multiple rooms, duplicate this .env with different ID_KAMERA:
# Room 701: ID_KAMERA=CAM-701
# Room 801: ID_KAMERA=CAM-801
# Room 901: ID_KAMERA=CAM-901

SEND_INTERVAL=2
ZONE_FETCH_INTERVAL=60
CONF_THRESHOLD=0.25
IOU_THRESHOLD=0.45

# Decision Engine
DELAY_ON_MINUTES=3
DELAY_OFF_MINUTES=5

# AI Service
AI_SERVICE_URL=http://localhost:8000
CAMERA_BASE_URL=http://localhost:8000

# Statistics
ENERGY_THRESHOLD_WATTS=500
PLN_EMISSION_FACTOR=0.00072
PLN_TARIFF_IDR_PER_WH=0.00138

# Boot Recovery
BOOT_RECOVERY_DELAY=15
# Seconds to wait after MQTT connects before sending restore commands
# Set to 15-20s to give ESP32 time to boot and subscribe

# DB Health Check  
DB_MAX_RETRIES=20
DB_RETRY_INTERVAL=3
MQTT_MAX_RETRIES=20
MQTT_RETRY_INTERVAL=3