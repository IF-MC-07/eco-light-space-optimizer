APP_NAME="AI Service"
CLIENT_URL=http://localhost:3000
DEBUG=True
ENVIRONMENT=development
PORT=8000

# Database
DB_USER=postgres
DB_HOST=localhost
DB_NAME=your_db_name
DB_PASSWORD=root
DB_PORT=5432
DB_SSL=false


DB_TYPE=supabase
SUPABASE_DATABASE_URL=your_supabase_url

# MQTT
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USER=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password
MQTT_TOPIC_PUBLISH=kelas/deteksi
MQTT_TOPIC_CONTROL=kelas/control


# Tuning
SEND_INTERVAL=2
ZONE_FETCH_INTERVAL=2
CONF_THRESHOLD=0.25
IOU_THRESHOLD=0.45

# Decision Engine
DELAY_ON_LIGHT_SECONDS=5
DELAY_ON_AC_MINUTES=3
DELAY_OFF_MINUTES=5
COMPRESSOR_PROTECTION_SECONDS=180

# MQTT Topics (overrides)
MQTT_TOPIC_TRIGGER=camera/trigger
# MQTT_TOPIC_RESULT=ai/inference/result
MQTT_TOPIC_CONTROL=kelas/control

# AI Service
AI_SERVICE_URL=http://localhost:8000
CAMERA_BASE_URL=http://localhost:8000

# OpenCV
OPENCV_FFMPEG_THREADS=1
OPENCV_FFMPEG_CAPTURE_OPTIONS=timeout;5000000

# Statistics
ENERGY_THRESHOLD_WATTS=500
PLN_EMISSION_FACTOR=0.00072
PLN_TARIFF_IDR_PER_WH=0.00138

# Boot Recovery
BOOT_RECOVERY_DELAY=10
# Seconds to wait after MQTT connects before sending restore commands
# Set to 15-20s to give ESP32 time to boot and subscribe

# DB Health Check  
DB_MAX_RETRIES=20
DB_RETRY_INTERVAL=3
MQTT_MAX_RETRIES=20
MQTT_RETRY_INTERVAL=3
CAMERA_SECRET_KEY=ecolight_secret_2026
MODEL_PATH=yolov8n.pt